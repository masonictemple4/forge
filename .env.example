# Database
# For local Docker setup, use these credentials:
DATABASE_URL=postgresql://forge:forge_dev_password@localhost:5432/forge

# Server
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Optional: Drizzle Studio
DRIZZLE_STUDIO_PORT=4983

# ============================================
# OAuth Configuration
# ============================================

# JWT Secret (generate a secure random string for production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# GitHub OAuth
# Create app at: https://github.com/settings/developers
# Callback URL: {BASE_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth
# Create app at: https://console.cloud.google.com/apis/credentials
# Callback URL: {BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple OAuth (Sign in with Apple)
# Create app at: https://developer.apple.com/account/resources/identifiers
# Callback URL: {BASE_URL}/auth/apple/callback
# Note: Apple requires HTTPS for callbacks (use ngrok for local development)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
